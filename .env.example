APP_ENV=staging
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=backingleaderboard&sslmode=require
DATABASE_SSL_CA_FILE=
# Public site origin; production requires your real HTTPS domain for SEO and sharing.
APP_URL=http://localhost:3018
PORT=3018
# Compose overrides the server port to 3010. Use the container's public origin.
DOCKER_APP_URL=http://localhost:3010
# Choose a free subnet if it conflicts with another Docker project or VPN.
DOCKER_SUBNET=10.241.10.0/24
SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAIL=admin@backing.local
ADMIN_PASSWORD=replace-with-a-strong-password
TRUST_PROXY=false
REDIS_URL=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
IPINFO_TOKEN=
BLOCKED_ASNS=
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_BACKING_PRODUCT_ID=
DODO_PLACEMENT_PRODUCT_ID=
DODO_PAYMENTS_ENVIRONMENT=test_mode
RESEND_API_KEY=
EMAIL_FROM=Backing <hello@example.com>
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
# On hosted deployments use a persistent volume, or configure all S3 settings above.
UPLOAD_DIR=./data/uploads
